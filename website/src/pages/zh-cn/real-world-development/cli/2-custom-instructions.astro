---
const target = `${import.meta.env.BASE_URL}zh-cn/real-world-development/cli/4-custom-instructions/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="zh-CN" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>正在跳转到自定义指令课程</title>
  </head>
  <body>
    <a href={target}>此课程已移动。请继续学习自定义指令课程。</a>
  </body>
</html>
