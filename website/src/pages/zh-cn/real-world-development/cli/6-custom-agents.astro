---
const target = `${import.meta.env.BASE_URL}zh-cn/real-world-development/cli/7-qa-agent/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="zh-CN" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>正在跳转到创建和使用 QA 智能体课程</title>
  </head>
  <body>
    <a href={target}>此课程已移动。请继续学习创建和使用 QA 智能体课程。</a>
  </body>
</html>
